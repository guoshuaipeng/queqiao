<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RootNamespace>RemoteAssist.Helper.UI</RootNamespace>
    <AssemblyName>RemoteAssist.Helper.UI</AssemblyName>
    <Product>鹊桥 · 协助端</Product>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RemoteAssist.Protocol\RemoteAssist.Protocol.csproj" />
    <ProjectReference Include="..\RemoteAssist.Relay.Stub\RemoteAssist.Relay.Stub.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RemoteAssist.Protocol.Tests" />
    <InternalsVisibleTo Include="RemoteAssist" />
    <InternalsVisibleTo Include="UiShot" />
  </ItemGroup>


  <ItemGroup>
    <Compile Include="..\UiShared\UiWindowPlacement.cs" Link="UiWindowPlacement.cs" />
  </ItemGroup>
</Project>



