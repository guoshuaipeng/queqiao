<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>RemoteAssist.Agent</RootNamespace>
    <AssemblyName>RemoteAssist.Agent.Avalonia</AssemblyName>
    <Product>鹊桥</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
</ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RemoteAssist.Protocol\RemoteAssist.Protocol.csproj" />
  </ItemGroup>

  <!-- 复用 Agent 核心（无 WinForms） -->
  <ItemGroup>
    <Compile Include="..\RemoteAssist.Agent\AgentHost.cs" Link="AgentHost.cs" />
    <Compile Include="..\RemoteAssist.Agent\Services.cs" Link="Services.cs" />
    <Compile Include="..\RemoteAssist.Agent\ConfirmModels.cs" Link="ConfirmModels.cs" />
    <Compile Include="..\RemoteAssist.Agent\TrustLevelSession.cs" Link="TrustLevelSession.cs" />
  </ItemGroup>
</Project>

